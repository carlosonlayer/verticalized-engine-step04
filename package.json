  "description": "VERTICALIZED Work Engine — Worker #001 Financeiro: Fechar o mês",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
