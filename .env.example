# Copie para .env SOMENTE em desenvolvimento local. Nunca faça commit do .env.
# Em produção, os segredos vêm do Secret Manager (ver deploy/cloudrun.sh).
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
APP_VERSION=dev

# Origens do frontend, separadas por vírgula. '*' é proibido em produção.
CORS_ORIGINS=http://localhost:5173

# Projeto Supabase EXCLUSIVO da VERTICALIZED (região São Paulo). Nunca o da Ízis.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Usado a partir do STEP 05. Sempre conta com faturamento ativo (plano pago).
GEMINI_API_KEY=
GEMINI_MODEL=
